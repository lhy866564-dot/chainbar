## 环境变量：数据库、JWT、链上配置
## 复制为 .env 后按本机情况修改，.env 不进仓库

PORT=5100
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS 允许来源，逗号分隔
CORS_ORIGINS=http://localhost:5100

# 链上配置（不填则交易接口返回 503，聊天/论坛不受影响）
RPC_URL=http://127.0.0.1:8545
ESCROW_CONTRACT=0x0000000000000000000000000000000000000000
# 后端托管账户私钥：仅本地测试链使用，绝不要放主网私钥
DEMO_PRIVATE_KEY=
# ABI 产物路径（相对 backend 目录）
ESCROW_ABI_PATH=../blockchain/build/TradeEscrow.json
